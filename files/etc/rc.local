# Put your custom commands here that should be executed once
# the system init finished. By default this file does nothing.

(sleep 60; ip link set lan1 down; sleep 2; ip link set lan1 up) &
(sleep 50; ip link set lan1 down; sleep 2; ip link set lan1 up) &
(while true; do sleep 3480; sync; echo 3 > /proc/sys/vm/drop_caches; done) &

exit 0
